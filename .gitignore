# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Electron GUI
gui/node_modules/
gui/dist/
gui/build/
gui/out.log
gui/err.log
gui/smoke-result.json

# Bundled third-party binaries (downloaded at release-build time, never committed)
gui/resources/bin/win/*
!gui/resources/bin/win/.gitkeep
gui/resources/bin/linux/*
!gui/resources/bin/linux/.gitkeep

# PyInstaller work dirs (build/ and dist/ are already ignored above)
spec/
*.spec

# Runtime artifacts (userData / scan storage / reports / exports)
gui/userData/
gui/reports/
*.log

# Local reports generated by scans
pehredar_report.json

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/